{
  "name": "vortex-desktop",
  "productName": "vortex-desktop",
  "version": "2.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "VITE_ELECTRON=true electron-forge start",
    "package": "VITE_ELECTRON=true electron-forge package",
    "make": "rm -rf out && VITE_ELECTRON=true electron-forge make",
    "reinstall": "rm -rf out && VITE_ELECTRON=true electron-forge make && sudo rpm -e vortex-desktop-2.0.0-1.fc43.x86_64 && sudo rpm -i /home/shanto/Downloads/vortex/electron-app/out/make/rpm/x64/vortex-desktop-2.0.0-1.x86_64.rpm",
    "publish": "VITE_ELECTRON=true electron-forge publish",
    "dev": "VITE_API_URL=/api vite dev --config vite.web.config.mjs",
    "build": "rm -rf dist && VITE_API_URL=/api VITE_WEB_BUILD=true vite build --config vite.web.config.mjs && rm -rf /home/shanto/Documents/BCS/html/dist && cp -rf dist/ /home/shanto/Documents/BCS/html/",
    "android": "rm -rf dist && rm -f ../android-app/app/src/main/assets/index.html && VITE_ANDROID_BUILD=true vite build --config vite.android.single-file.config.mjs && cp ./dist/index.html ../android-app/app/src/main/assets/index.html",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "copy-index": "cp ./dist/index.html ../android-app/app/src/main/assets/index.html"
  },
  "keywords": [],
  "author": {
    "name": "Shanto Noor",
    "email": "shantonoor900@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^2.1.0",
    "electron": "41.0.3",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@embedpdf/react-pdf-viewer": "^2.10.0",
    "@excalidraw/common": "file:.yalc/@excalidraw/common",
    "@excalidraw/element": "file:.yalc/@excalidraw/element",
    "@excalidraw/excalidraw": "file:.yalc/@excalidraw/excalidraw",
    "@excalidraw/math": "file:.yalc/@excalidraw/math",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^6.0.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.5.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-resizable-panels": "^4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vortex-core-lib-js": "file:.yalc/vortex-core-lib-js",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "resolutions": {
    "@excalidraw/common": "file:.yalc/@excalidraw/common",

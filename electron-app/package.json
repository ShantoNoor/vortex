{
  "name": "vortex-desktop",
  "productName": "vortex-desktop",
  "version": "2.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "env:electron": "cross-env VITE_ELECTRON=true",
    "env:web": "cross-env VITE_API_URL=/api",
    "env:android": "cross-env VITE_ANDROID_BUILD=true",
    "vite:web": "vite build --config vite.web.config.mjs",
    "vite:android": "vite build --config vite.android.config.mjs",
    "start": "yarn env:electron electron-forge start",
    "package": "yarn env:electron electron-forge package",
    "make": "yarn clean && yarn env:electron electron-forge make",
    "publish": "yarn env:electron electron-forge publish",
    "dev": "yarn env:web vite dev --config vite.web.config.mjs",
    "devh": "yarn env:web vite dev --host --config vite.web.config.mjs",
    "build": "yarn clean && yarn env:web cross-env VITE_WEB_BUILD=true yarn vite:web && yarn clean:web && yarn copy:web",
    "android": "yarn clean && yarn env:android yarn vite:android && yarn clean:android && yarn copy:android",
    "reinstall": "yarn make && yarn rpm:uninstall && yarn rpm:install",
    "clean": "rm -rf dist out",
    "clean:web": "source ./.env.web && rm -rf $WEB_DIST_PATH/dist",
    "clean:android": "rm -rf ../android-app/app/src/main/assets/index.html ../android-app/app/src/main/assets/assets",
    "copy:web": "source ./.env.web && cp -rf dist/ $WEB_DIST_PATH/",
    "copy:android": "cp ./dist/index.html ../android-app/app/src/main/assets/index.html && cp -r ./dist/assets ../android-app/app/src/main/assets/assets",
    "rpm:uninstall": "sudo rpm -e vortex-desktop-2.0.0-1.fc43.x86_64",
    "rpm:install": "sudo rpm -i /home/shanto/Downloads/vortex/electron-app/out/make/rpm/x64/vortex-desktop-2.0.0-1.x86_64.rpm",
    "rebuild:better-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "preinstall": "yarn sync",
    "postinstall": "patch-package",
    "vortex-core-lib-js:pull": "cd ../@core-lib-js && yarn install",
    "vortex-core-lib-js:publish": "cd ../@core-lib-js && yalc publish",
    "excalidraw:pull": "cd ../../excalidraw && git pull origin master && yarn install && yarn build:packages",
    "excalidraw:publish": "cd ../../excalidraw/packages/common && yalc publish && cd ../element && yalc publish && cd ../excalidraw && yalc publish && cd ../math && yalc publish",
    "update-deps": "yalc update @excalidraw/common @excalidraw/element @excalidraw/excalidraw @excalidraw/math vortex-core-lib-js",
    "sync": "yarn excalidraw:pull && yarn excalidraw:publish && yarn vortex-core-lib-js:pull && yarn vortex-core-lib-js:publish && yarn update-deps"
  },
  "keywords": [],
  "author": {
    "name": "Shanto Noor",
    "email": "shantonoor900@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^2.1.0",
    "cross-env": "*",
    "electron": "41.0.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@embedpdf/react-pdf-viewer": "^2.10.1",
    "@excalidraw/common": "file:.yalc/@excalidraw/common",
    "@excalidraw/element": "file:.yalc/@excalidraw/element",
    "@excalidraw/excalidraw": "file:.yalc/@excalidraw/excalidraw",
    "@excalidraw/math": "file:.yalc/@excalidraw/math",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^6.0.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-resizable-panels": "^4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vm-browserify": "^1.1.2",
    "vortex-core-lib-js": "file:.yalc/vortex-core-lib-js",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "resolutions": {
    "@excalidraw/common": "file:.yalc/@excalidraw/common",
    "@excalidraw/element": "file:.yalc/@excalidraw/element",
    "@excalidraw/math": "file:.yalc/@excalidraw/math"
  }
}

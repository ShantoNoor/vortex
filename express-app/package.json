{
  "name": "express-app",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "DEV=true node --watch server.js",
    "start": "node server.js",
    "preinstall": "yarn sync",
    "update-dps": "yalc update vortex-core-lib-js",
    "vortex-core-lib-js:pull": "cd ../@core-lib-js && yarn install",
    "vortex-core-lib-js:publish": "cd ../@core-lib-js && yalc publish",
    "sync": "yarn vortex-core-lib-js:pull && yarn vortex-core-lib-js:publish && yarn update-dps"
  },
  "keywords": [],
  "author": "Shanto Noor",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "vortex-core-lib-js": "file:.yalc/vortex-core-lib-js"
  }
}
